{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Eclipse",
  "version": "0.1.3",
  "identifier": "com.eclipse.clipper",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Eclipse",
        "width": 1380,
        "height": 840,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "visible": true,
        "decorations": false,
        "center": true
      },
      {
        "label": "overlay",
        "title": "Eclipse Overlay",
        "url": "overlay.html",
        "width": 460,
        "height": 160,
        "x": 24,
        "y": 72,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY2ODFFQ0M0MkQ0MTVBNjcKUldSbldrRXR4T3lCWnV2UFJDZG16VFR6Sk8yLytQMDJTRk1iVDUxbEo4UzBvcStvNUREQjg1TXAK",
      "endpoints": [
        "https://github.com/Skywalkie-cyber/Eclipse-Valorant-Replay-Engine/releases/latest/download/latest.json",
        "https://github.com/Skywalkie-cyber/Eclipse-Zero-Latency-Valorant-Replay-Highlight-Engine/releases/latest/download/latest.json"
      ]
    }
  }
}

